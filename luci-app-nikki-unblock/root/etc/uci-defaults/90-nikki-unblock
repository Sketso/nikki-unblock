#!/bin/sh
# Post-install wiring for nikki-unblock.

# CGI must be executable (package files usually keep mode, but be safe).
[ -f /www/cgi-bin/nikki-unblock ] && chmod 0755 /www/cgi-bin/nikki-unblock

# node store for the VPN-nodes tab (root-only; holds keys)
mkdir -p /etc/nikki-unblock/nodes /etc/nikki-unblock/providers /etc/nikki-unblock/subs /etc/nikki-unblock/backups
chmod 700 /etc/nikki-unblock /etc/nikki-unblock/nodes /etc/nikki-unblock/providers /etc/nikki-unblock/subs /etc/nikki-unblock/backups 2>/dev/null

# Seed the config section if it is somehow missing (the shipped /etc/config/nikki-unblock covers this).
if ! uci -q get nikki-unblock.config >/dev/null 2>&1; then
	touch /etc/config/nikki-unblock
	uci -q set nikki-unblock.config=nikki-unblock
	uci -q set nikki-unblock.config.applist_url='https://sketso.github.io/nikki-unblock/applist'
	uci -q set nikki-unblock.config.autosync_enabled='0'
	uci -q set nikki-unblock.config.autosync_interval='24h'
	uci -q set nikki-unblock.config.lang='ru'
	uci -q set nikki-unblock.config.base_group='PROXY'
	uci -q set nikki-unblock.config.exit_group='UNBLOCK'
	uci -q set nikki-unblock.config.node_mode='fallback'
	uci -q set nikki-unblock.config.subauto='1'
	uci -q set nikki-unblock.config.subauto_interval='24h'
	uci -q commit nikki-unblock
fi

# Drop any stale autosync cron line from the predecessor CGI (nikki-domains), if present.
[ -f /etc/crontabs/root ] && sed -i '/nikki-domains/d' /etc/crontabs/root && /etc/init.d/cron restart >/dev/null 2>&1

# Seed the exit-node mode once. Keyed on the VALUE being absent rather than on the init flag below, so
# the flag can stay unset for a later retry without this ever clobbering a mode the user has changed.
if [ -z "$(uci -q get nikki-unblock.config.node_mode 2>/dev/null)" ]; then
	uci -q set nikki-unblock.config.node_mode='fallback'
	uci -q commit nikki-unblock
fi

# Build the managed exit group (UNBLOCK) so "→ VPN" rules resolve. `regen` asks a LIVE mihomo for the
# profile's node names, so it only works once nikki is installed AND running. Nipret is legitimately
# installed BEFORE nikki (a user hit exactly this), and the flag used to be burned regardless — leaving
# UNBLOCK missing forever and "→ VPN" pointing at a group that doesn't exist. Record success ONLY, so an
# install that was too early simply retries on the next package upgrade; the panel also self-heals at
# runtime (nodes_init_once in the CGI) so it doesn't have to wait for one.
if [ "$(uci -q get nikki-unblock.config._nodes_init 2>/dev/null)" != 1 ] \
	&& [ -x /www/cgi-bin/nikki-unblock ] && pgrep -f /usr/bin/mihomo >/dev/null 2>&1; then
	/www/cgi-bin/nikki-unblock regen 2>/dev/null
	/etc/init.d/nikki reload >/dev/null 2>&1
	uci -q set nikki-unblock.config._nodes_init='1'
	uci -q commit nikki-unblock
fi

# zapret2 desync-rules watchdog (fw4 "start doesn't rebuild the firewall" self-heal). The script no-ops
# when zapret2 is absent/disabled, so it's safe to schedule unconditionally (also covers zapret2 added
# later). Idempotent: only add the cron line once.
chmod 0755 /usr/bin/nikki-unblock-z2-watchdog 2>/dev/null
# per-device capture tool: run by hand over ssh AND by the panel (the CGI refuses to start a capture
# when it isn't executable, so this is what makes the third diagnostic work at all)
chmod 0755 /usr/bin/nikki-unblock-trace 2>/dev/null
if [ -f /etc/crontabs/root ] || touch /etc/crontabs/root; then
	grep -q nikki-unblock-z2-watchdog /etc/crontabs/root 2>/dev/null || {
		echo '*/5 * * * * /usr/bin/nikki-unblock-z2-watchdog' >> /etc/crontabs/root
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	}
fi

# Exit-node health watchdog: self-heals added VPN nodes that stop responding (auto-disable) or come
# back (auto re-enable), e.g. a node's server going down for maintenance and returning later — without
# touching anything the user disabled by hand. No-ops until at least one node is added, so it's safe to
# schedule unconditionally (also covers nodes added later).
if [ -f /etc/crontabs/root ] || touch /etc/crontabs/root; then
	grep -q 'nikki-unblock nodewatch' /etc/crontabs/root 2>/dev/null || {
		echo '*/5 * * * * /www/cgi-bin/nikki-unblock nodewatch' >> /etc/crontabs/root
		/etc/init.d/cron enable >/dev/null 2>&1
		/etc/init.d/cron restart >/dev/null 2>&1
	}
fi

# Collapse exact-duplicate crontab lines (order-preserving). Not our lines to own, but a co-installed
# zapret v1 (leftover /etc/config/zapret) appends a `/tmp/zapret+*.log` cleanup line without dedup, so it
# piles up (seen 19x). Identical cron lines are never intentional — they'd just run the same command
# twice at once — so keeping one of each is safe and self-heals the crontab on every upgrade.
if [ -f /etc/crontabs/root ]; then
	awk '!seen[$0]++' /etc/crontabs/root > /etc/crontabs/root.dedup 2>/dev/null &&
		! cmp -s /etc/crontabs/root /etc/crontabs/root.dedup && {
			mv /etc/crontabs/root.dedup /etc/crontabs/root
			/etc/init.d/cron restart >/dev/null 2>&1
		}
	rm -f /etc/crontabs/root.dedup 2>/dev/null
fi

# 2.36.0: the split-tunnel Discord preset ("site via VPN, voice direct") is retired — that is the one
# arrangement Discord refuses, because the voice server only accepts packets from the address the
# gateway connected from. Release what it owned. Nothing else can: the panel and autosync only manage
# presets the manifest still lists, so once the entry is gone its rules would sit here forever with no
# way to switch them off. Rules shared with another preset keep that owner and stay.
if [ -z "$(uci -q get nikki-unblock.config.mig_discord_web 2>/dev/null)" ]; then
	_mg=0; _guard=0
	while [ "$_guard" -lt 500 ]; do
		_guard=$((_guard + 1))
		_hit=""; _i=0
		while uci -q get "nikki.@rule[$_i]" >/dev/null 2>&1; do
			case " $(uci -q get "nikki.@rule[$_i].src" 2>/dev/null) " in
				*" discord-web "*) _hit="$_i"; break ;;
			esac
			_i=$((_i + 1))
		done
		[ -z "$_hit" ] && break
		_src=$(uci -q get "nikki.@rule[$_hit].src")
		_rest=$(echo " $_src " | sed 's/ discord-web / /g; s/^ *//; s/ *$//; s/  */ /g')
		if [ -n "$_rest" ]; then uci -q set "nikki.@rule[$_hit].src=$_rest"
		else uci -q delete "nikki.@rule[$_hit]"; fi
		_mg=$((_mg + 1))
	done
	[ "$_mg" -gt 0 ] && uci -q commit nikki
	uci -q set nikki-unblock.config.mig_discord_web='1'
	uci -q commit nikki-unblock
	[ "$_mg" -gt 0 ] && logger -t nikki-unblock "migration: released $_mg rule(s) of the retired discord-web preset"
fi

# --- DNS: replace nikki's upstream (Chinese) resolver defaults with the router's own -------------
# nikki is a China-first package and ships DNS to match: AliDNS as default-nameserver, AliDNS DoH for
# proxy/direct, and a `geosite:geolocation-!cn` policy pointing at DoH 1.1.1.1 / 8.8.8.8. On a Russian
# line that is exactly backwards — those DoH endpoints are throttled, so the domains that would resolve
# perfectly well LOCALLY (Kinopoisk, Yandex) time out, while proxied ones keep working because fake-ip
# resolves them at the node. Reported from a fresh install; every stock install has it.
#
# The fix is the router's own resolver. That is safe precisely BECAUSE of fake-ip: a domain matched by
# a rule never needs an honest local answer, so dnsmasq is enough and nothing depends on an upstream
# we cannot reach. Runs once (flag) and only switches OFF entries that still hold the stock Chinese
# values — someone who set their own resolver keeps it. IPv6 is deliberately left alone: both routers
# this was verified on run dns_ipv6='1' and resolve fine, so it is not part of the problem.
if [ -z "$(uci -q get nikki-unblock.config.mig_dns_local 2>/dev/null)" ] \
	&& uci -q get nikki.mixin >/dev/null 2>&1; then
	_ch=0
	# 1. retire stock upstreams: any nameserver/policy section still pointing at AliDNS or the DoH pair
	for _sec in nameserver nameserver_policy; do
		_i=0
		while uci -q get "nikki.@$_sec[$_i]" >/dev/null 2>&1; do
			case " $(uci -q get "nikki.@$_sec[$_i].nameserver" 2>/dev/null) " in
				*223.5.5.5*|*223.6.6.6*|*1.1.1.1*|*8.8.8.8*)
					[ "$(uci -q get "nikki.@$_sec[$_i].enabled" 2>/dev/null)" = 0 ] || {
						uci -q set "nikki.@$_sec[$_i].enabled=0"; _ch=1
					} ;;
			esac
			_i=$((_i + 1))
		done
	done
	# 2. make sure both kinds that mihomo actually consults point at the local resolver
	for _t in default-nameserver nameserver; do
		_found=""; _i=0
		while uci -q get "nikki.@nameserver[$_i]" >/dev/null 2>&1; do
			[ "$(uci -q get "nikki.@nameserver[$_i].type" 2>/dev/null)" = "$_t" ] && { _found="$_i"; break; }
			_i=$((_i + 1))
		done
		if [ -z "$_found" ]; then
			uci -q add nikki nameserver >/dev/null
			uci -q set "nikki.@nameserver[-1].type=$_t"
			uci -q set "nikki.@nameserver[-1].enabled=1"
			uci -q add_list "nikki.@nameserver[-1].nameserver=127.0.0.1"
			_ch=1
		elif [ "$(uci -q get "nikki.@nameserver[$_found].nameserver" 2>/dev/null)" != "127.0.0.1" ]; then
			uci -q delete "nikki.@nameserver[$_found].nameserver" 2>/dev/null
			uci -q add_list "nikki.@nameserver[$_found].nameserver=127.0.0.1"
			uci -q set "nikki.@nameserver[$_found].enabled=1"
			_ch=1
		else
			[ "$(uci -q get "nikki.@nameserver[$_found].enabled" 2>/dev/null)" = 1 ] || {
				uci -q set "nikki.@nameserver[$_found].enabled=1"; _ch=1
			}
		fi
	done
	# 3. the mixin switches that decide whether those sections are emitted at all
	for _kv in dns_nameserver=1 dns_nameserver_policy=0 dns_proxy_server_nameserver_policy=0 \
	           dns_direct_nameserver_follow_policy=0; do
		_k=${_kv%%=*}; _v=${_kv##*=}
		[ "$(uci -q get "nikki.mixin.$_k" 2>/dev/null)" = "$_v" ] || { uci -q set "nikki.mixin.$_k=$_v"; _ch=1; }
	done
	if [ "$_ch" = 1 ]; then
		uci -q commit nikki
		# The commit IS the fix — it takes effect the next time nikki starts. Applying it right now is
		# optional, and on a tight router it is a bad trade: reload_service is `cleanup; start`, the two
		# mihomo instances overlap, and the box this was written on (233 MB RAM, mihomo ~57 MB RSS) had
		# the kernel OOM-kill mihomo doing exactly this mid-upgrade. So touch a running proxy only with
		# real headroom; otherwise leave it for the next start and say so in the log.
		_av=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo 2>/dev/null)
		if ! pgrep -f /usr/bin/mihomo >/dev/null 2>&1; then
			logger -t nikki-unblock "migration: DNS switched to the local resolver (nikki shipped Chinese upstreams)"
		elif [ -n "$_av" ] && [ "$_av" -ge 262144 ]; then
			[ -x /etc/init.d/nikki ] && /etc/init.d/nikki restart >/dev/null 2>&1
			logger -t nikki-unblock "migration: DNS switched to the local resolver and applied (nikki shipped Chinese upstreams)"
		else
			logger -t nikki-unblock "migration: DNS switched to the local resolver; restart deferred, MemAvailable ${_av:-?} kB — applies on next nikki start"
		fi
	fi
	uci -q set nikki-unblock.config.mig_dns_local='1'
	uci -q commit nikki-unblock
fi

# Refresh the LuCI menu/index cache so the new entry shows up.
rm -f /tmp/luci-indexcache* 2>/dev/null
rm -rf /tmp/luci-modulecache 2>/dev/null

exit 0
